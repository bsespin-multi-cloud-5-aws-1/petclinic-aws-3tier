[Unit]
Description=Apache Tomcat for Petclinic
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple
User=tomcat
Group=tomcat

EnvironmentFile=/etc/petclinic/bootstrap.env
Environment="JAVA_HOME=/usr/lib/jvm/java-1.8.0-amazon-corretto.x86_64"
Environment="CATALINA_HOME=/opt/tomcat"
Environment="CATALINA_BASE=/opt/tomcat"

RuntimeDirectory=petclinic
RuntimeDirectoryMode=0700

  ExecStartPre=+/usr/bin/install -d -o tomcat -g tomcat -m 0750 /opt/tomcat/logs/petclinic
ExecStartPre=/usr/bin/python3 /opt/petclinic-bootstrap/fetch_db_secret.py
ExecStart=/opt/tomcat/bin/catalina.sh run

SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0027

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
