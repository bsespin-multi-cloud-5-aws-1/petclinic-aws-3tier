# /etc/petclinic/bootstrap.env (root:tomcat 0640) — tomcat.service 의 EnvironmentFile
# 운영 값 중 시크릿 ARN·RDS 주소는 자리표시자로 바꿈. 나머지 셋은 운영 값 그대로.
AWS_REGION=ap-northeast-2
PETCLINIC_SECRET_ID=arn:aws:secretsmanager:ap-northeast-2:<ACCOUNT_ID>:secret:<SECRET_NAME>
PETCLINIC_DB_HOST=<주 DB 엔드포인트>
PETCLINIC_DB_REPLICA_HOST=<읽기 복제본 엔드포인트>
PETCLINIC_DB_PORT=3306
PETCLINIC_DB_NAME=petclinic
