<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>

<configuration scan="true" scanPeriod="30 seconds">

	<contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
		<resetJUL>true</resetJUL>
	</contextListener>

      <!-- 애플리케이션 로그 저장 디렉터리 -->
      <property name="APP_LOG_DIR"
                value="/opt/tomcat/logs/petclinic"/>

      <!-- 파일 저장 및 날짜별 로그 회전 -->
      <appender name="APPLICATION"
                class="ch.qos.logback.core.rolling.RollingFileAppender">

          <!-- 현재 기록 중인 로그 파일 -->
          <file>${APP_LOG_DIR}/application.log</file>
          <append>true</append>

          <rollingPolicy
                  class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

              <!-- 날짜가 바뀌면 이전 로그를 이 이름으로 보관 -->
              <fileNamePattern>${APP_LOG_DIR}/application.%d{yyyy-MM-dd}.log</fileNamePattern>

              <!-- 로컬 보관 기간 -->
              <maxHistory>31</maxHistory>
          </rollingPolicy>

          <encoder>
              <charset>UTF-8</charset>
              <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
          </encoder>
      </appender>

      <logger name="org.springframework.samples.petclinic" level="INFO"/>

      <root level="INFO">
          <appender-ref ref="APPLICATION"/>
      </root>

  </configuration>
