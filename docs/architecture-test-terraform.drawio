180" width="130" height="118" as="geometry" /></mxCell><mxCell id="acm" value="cloudfront: us-east-1&lt;br&gt;alb: 서울 (오리진)&lt;br&gt;DNS 검증" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager;fontFamily=Helvetica;" vertex="1" parent="grp-acm"><mxGeometry x="43" y="26" width="44" height="44" as="geometry" /></mxCell><mxCell id="grp-waf" value="WAF v2 (CLOUDFRONT)" style="fillColor=#FFEBEE;strokeColor=#DD344C;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#DD344C;fontFamily=Helvetica;container=1;collapsible=0;shadow=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="340" width="200" height="140" as="geometry" /></mxCell><mxCell id="waf" value="mc-web-acl · 관리형 3종(IpReputation·&lt;br&gt;Common·KnownBadInputs) · rate-all 2000&lt;br&gt;rate-booking 100(visits/new) · loadgen 허용&lt;br&gt;로그 → aws-waf-logs-mc" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;fontFamily=Helvetica;" vertex="1" parent="grp-waf"><mxGeometry x="78" y="26" width="44" height="44" as="geometry" /></mxCell><mxCell id="grp-cf" value="CloudFront" style="fillColor=#EDE7F6;strokeColor=#8C4FFF;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#8C4FFF;fontFamily=Helvetica;container=1;collapsible=0;shadow=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="340" width="200" height="140" as="geometry" /></mxCell><mxCell id="cf" value="aws_cloudfront_distribution.main · PriceClass_200&lt;br&gt;TLSv1.2_2021 · aliases=[domain_name]&lt;br&gt;origin alb-public(HTTPS, X-Origin-Verify 헤더)&lt;br&gt;origin s3-maintenance(OAC) · 오리진 그룹 failover 5xx" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;fontFamily=Helvetica;" vertex="1" parent="grp-cf"><mxGeometry x="78" y="26" width="44" height="44" as="geometry" /></mxCell><mxCell id="cf-beh" value="&lt;b&gt;Behavior&lt;/b&gt;&lt;br&gt;• &lt;code&gt;/petclinic/resources/*&lt;/code&gt; → 오리진 그룹(ALB→S3 failover) · CachingOptimized · AllViewer(Host 전달)&lt;br&gt;• &lt;code&gt;/maintenance.html&lt;/code&gt; → s3-maintenance&lt;br&gt;• &lt;code&gt;*&lt;/code&gt;(기본) → alb-public · CachingDisabled · AllViewer&lt;br&gt;• 502/503/504 → 503 + /maintenance.html (10s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FB;strokeColor=#0B5394;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="495" width="420" height="120" as="geometry" /></mxCell><mxCell id="grp-s3-maint" value="S3 점검 페이지" style="fillColor=#E8F5E9;strokeColor=#1B8B3B;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#1B8B3B;fontFamily=Helvetica;container=1;collapsible=0;shadow=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="200" height="118" as="geometry" /></mxCell><mxCell id="s3-maint" value="mc-maintenance-&amp;lt;account&amp;gt;&lt;br&gt;maintenance.html · OAC 전용&lt;br&gt;KMS · 버저닝 · 퍼블릭 차단" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#1B8B3B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_storage_service;fontFamily=Helvetica;" vertex="1" parent="grp-s3-maint"><mxGeometry x="78" y="26" width="44" height="44" as="geometry" /></mxCell><mxCell id="grp-kms" value="KMS CMK" style="fillColor=#FFEBEE;strokeColor=#DD344C;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#DD344C;fontFamily=Helvetica;container=1;collapsible=0;shadow=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="630" width="200" height="118" as="geometry" /></mxCell><mxCell id="kms" value="mc-kms (alias)&lt;br&gt;S3 · RDS · Secrets · Logs 암호화&lt;br&gt;CloudFront OAC Decrypt 허용" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;fontFamily=Helvetica;" vertex="1" parent="grp-kms"><mxGeometry x="78" y="26" width="44" height="44" as="geometry" /></mxCell><mxCell id="edge-why" value="&lt;b&gt;왜 이렇게&lt;/b&gt;&lt;br&gt;• Public ALB SG 는 CloudFront origin-facing 프리픽스 리스트 443 만 허용 + 리스너 기본 403, &lt;code&gt;X-Origin-Verify&lt;/code&gt; 헤더 일치 시에만 forward → CloudFront 우회 차단&lt;br&gt;• WAF 는 CLOUDFRONT 스코프(us-east-1) — 예약 폭주(Phase 3)용 booking 경로 rate 100&lt;br&gt;• 점검 페이지는 S3 OAC 로만 읽기 → ALB 5xx 시 CloudFront 가 자동 failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FB;strokeColor=#0B5394;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="770" width="420" height="150" as="geometry" /></mxCell><mxCell id="edge-var" value="&lt;b&gt;variables.tf 기본값&lt;/b&gt;&lt;br&gt;web t3.small ASG 2~6 (CPU 60%) · was t3.medium ASG 2~8 (CPU 60% + 요청 300/대상) · 예약 증설 desired 4 (KST 09:45~12:00)&lt;br&gt;db.t3.small · app_repo_branch=&lt;b&gt;test&lt;/b&gt; · waf_rate_limit_all 2000 · booking 100 · alert_emails=[] · enable_grafana=false · log_retention 30일&lt;br&gt;필수 입력: domain_name · hosted_zone_name · origin_verify_secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FB;strokeColor=#0B5394;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="940" width="420" height="170" as="geometry" /></mxCell><mxCell id="edge-out" value="&lt;b&gt;outputs.tf&lt;/b&gt; cloudfront_domain · app_url · public_alb_dns · internal_alb_dns · rds_proxy_endpoint · rds_master_secret_arn · buckets · sns_alerts_topic_arn · route53_name_servers(가비아 NS 위임)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FB;strokeColor=#0B5394;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="1130" width="420" height="90" as="geometry" /></mxCell><mxCell id="region" value="ap-northeast-2 (var.region) · versions.tf aws ~&gt; 5.x · default_tags" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;stroke