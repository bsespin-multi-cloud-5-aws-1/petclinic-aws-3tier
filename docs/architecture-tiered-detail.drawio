        <mxCell id="ls-0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;fontFamily=Helvetica;" edge="1" parent="legend-line-styles-group">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="16" y="34" as="sourcePoint" />
            <mxPoint x="90" y="34" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls-t-0" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;실선 : 요청 흐름 (사용자 → DB)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="legend-line-styles-group">
