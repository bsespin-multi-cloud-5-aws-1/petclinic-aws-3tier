        </mxCell>
        <mxCell id="legend-line-styles-bg" value="선 종류" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="legend-line-styles-group">
          <mxGeometry width="456" height="120" as="geometry" />
