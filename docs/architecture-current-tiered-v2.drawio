        <mxCell id="beh" value="CloudFront 내부 처리 순서: WAF Web ACL 평가 → 캐시 조회 → Behavior (주소로 분기)&lt;br&gt;1) /petclinic/resources/* → ALB · CachingOptimized 1일&lt;br&gt;2) /maintenance.html → S3 점검 버킷(OAC)&lt;br&gt;3) 기본(/*) → ALB · CachingDisabled · AllViewer" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#8C4FFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="790" width="760" height="90" as="geometry" />
        </mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1">
