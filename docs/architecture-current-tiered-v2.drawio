        <mxCell id="e-waflog" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;elbow=vertical;startArrow=none;strokeColor=#545B64;rounded=0;dashed=1;fontFamily=Helvetica;strokeColor=#E7157B;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cf" target="cwl-was"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="210" /><mxPoint x="1582" y="210" /></Array></mxGeometry></mxCell><mxCell id="e-waflog-label" value="WAF 로그 (aws-waf-logs-mc) → CloudWatch Logs" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-waflog"><mxGeometry relative="1" x="-0.3" y="-10" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="note-behavior" value="&lt;b&gt;Behavior 분기 (오리진 3: ALB · 정적 S3 · 점검 S3)&lt;/b&gt;&lt;br&gt;• 정적 &lt;code&gt;/static/*&lt;/code&gt; &lt;code&gt;/images/*&lt;/code&gt; → &lt;b&gt;S3 mc-static (OAC)&lt;/b&gt; · CachingOptimized 1일 → Hit 면 엣지, Miss 면 S3 (Apache 안 거침)&lt;br&gt;• &lt;code&gt;/petclinic/resources/*&lt;/code&gt; &lt;code&gt;/petclinic/images/*&lt;/code&gt;(WAR 안) → ALB 캐시&lt;br&gt;• 동적 &lt;code&gt;*&lt;/code&gt; → CachingDisabled + AllViewer → 매번 ALB&lt;br&gt;• &lt;code&gt;/maintenance.html&lt;/code&gt; → 점검 S3 OAC · 오리진 5xx → 503" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FB;strokeColor=#0B5394;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=9;fontColor=#232F3E;spacing=5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="255" width="280" height="130" as="geometry" /></mxCell><mxCell id="grp-s3static" value="정적 자산 (OAC)" style="fillColor=#E8F5E9;strokeColor=#3F8624;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#3F8624;fontFamily=Helvetica;container=1;collapsible=0;shadow=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="260" width="