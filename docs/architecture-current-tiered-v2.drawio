          <mxGeometry x="0" y="234" width="556" height="96" as="geometry" />
        </mxCell>
        <mxCell id="lg-b-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="lg-3">
          <mxGeometry y="2" width="38" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lg-d-3" value="&lt;div&gt;&lt;b&gt;Grafana 대시보드&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Amazon Managed Grafana(Identity Center 로그인, 편집자 $9/월). CloudWatch 데이터소스. 행: 진입 → ALB → EC2 → RDS. Phase 3 전/후 비교는 Time shift&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="lg-3">
          <mxGeometry x="48" width="508" height="96" as="geometry" />
        </mxCell>
        <mxCell id="lg-4" value="" style="group;fontFamily=Helvetica;" connectable="0" vertex="1" parent="legend-container">
          <mxGeometry x="0" y="334" width="556" height="96" as="geometry" />
        </mxCell>
        <mxCell id="lg-b-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="lg-4">
          <mxGeometry y="2" width="38" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lg-d-4" value="&lt;div&gt;&lt;b&gt;알람 → 이메일 (기본)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudWatch 알람 3개(HealthyHost&lt;2 · DB 연결 · p95≥2s) → SNS mc-alerts → 팀 이메일. Grafana 도입 전까지의 기본 경로. 6일차 WAS 1대 중지로 수신 테스트&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="lg-4">
          <mxGeometry x="48" width="508" height="96" as="geometry" />
        </mxCell>
