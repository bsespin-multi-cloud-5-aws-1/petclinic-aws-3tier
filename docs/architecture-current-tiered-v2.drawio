        <mxCell id="lg-b-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="lg-5">
          <mxGeometry y="2" width="38" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lg-d-5" value="&lt;div&gt;&lt;b&gt;Slack (Grafana Alerting 단일 경로)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Slack 알림은 Grafana Alerting → Contact point(Incoming Webhook) 한 경로. webhook URL은 Grafana에만 저장&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="lg-5">
          <mxGeometry x="48" width="508" height="96" as="geometry" />
        </mxCell>
