          <mxGeometry x="0" y="534" width="556" height="96" as="geometry" />
        </mxCell>
        <mxCell id="lg-b-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="lg-6">
          <mxGeometry y="2" width="38" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lg-d-6" value="&lt;div&gt;&lt;b&gt;알람 → Auto Scaling&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;WAS ASG 대상 추적(대상당 요청 수·CPU)이 CloudWatch 알람으로 동작. 예약 증설과 병행&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="lg-6">
          <mxGeometry x="48" width="508" height="96" as="geometry" />
