          <mxGeometry x="50" y="30" width="2200" height="83" as="geometry" />
        </mxCell>
        <mxCell id="title-text" value="② WEB 계층 · Public ALB → Apache Auto Scaling" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="title-group">
          <mxGeometry width="2000" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-text" value="IGW → Public ALB(443 · 헬스체크 /health.html) → WEB ASG(AL2023 · Apache MPM event) → Internal ALB | 로그: CloudWatch Agent · ALB 액세스 로그 · SSM 세션" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="title-group">
          <mxGeometry x="5" y="40" width="2000" height="25" as="geometry" />
        </mxCell>
        <mxCell id="title-separator" value="" style="line;strokeWidth=2;html=1;fontSize=14;strokeColor=#FF9900;fontFamily=Helvetica;" vertex="1" parent="title-group">
