          <mxGeometry x="0" y="134" width="556" height="96" as="geometry" />
        </mxCell>
        <mxCell id="lg-b-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="lg-2">
          <mxGeometry y="2" width="38" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lg-d-2" value="&lt;div&gt;&lt;b&gt;CloudWatch 지표 · 알람&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;ALB RequestCount·TargetResponseTime p95·5XX·HealthyHost, ASG 인스턴스 수, RDS CPU·DatabaseConnections, ACM DaysToExpiry. 알람 3개 + 대상 추적 알람&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="lg-2">
          <mxGeometry x="48" width="508" height="96" as="geometry" />
        </mxCell>
