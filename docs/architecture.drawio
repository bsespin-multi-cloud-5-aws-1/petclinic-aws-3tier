BD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="710" y="766" width="28" height="28" as="geometry"/></mxCell><mxCell id="p1-badge-45" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="710" y="956" width="28" height="28" as="geometry"/></mxCell><mxCell id="p1-legend-46" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1440" y="140" width="500" height="540" as="geometry"/></mxCell><mxCell id="p1-lt-47" value="기준선 구성 (필수 기능)" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="154" width="460" height="24" as="geometry"/></mxCell><mxCell id="p1-lb-48" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1460" y="192" width="40" height="38" as="geometry"/></mxCell><mxCell id="p1-ld-49" value="&lt;div&gt;&lt;b&gt;진입: Internet Gateway → Public ALB&lt;/b&gt;&lt;/div&gt;&lt;div&gt;사용자는 ALB DNS로 접속. 리스너 80 → WEB Target Group (헬스체크 &lt;code&gt;/&lt;/code&gt;, 기본 30초 간격)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1512" y="190" width="400" height="90" as="geometry"/></mxCell><mxCell id="p1-lb-50" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1460" y="288" width="40" height="38" as="geometry"/></mxCell><mxCell id="p1-ld-51" value="&lt;div&gt;&lt;b&gt;WEB: Apache 2.4&lt;/b&gt;&lt;/div&gt;&lt;div&gt;index.html 정적 서비스. &lt;code&gt;ProxyPass /petclinic/&lt;/code&gt; → Internal ALB DNS. 정적 자원(&lt;code&gt;/petclinic/resources/*&lt;/code&gt;)은 아직 Tomcat이 서빙&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1512" y="286" width="400" height="90" as="geometry"/></mxCell><mxCell id="p1-lb-52" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1460" y="384" width="40" height="38" as="geometry"/></mxCell><mxCell id="p1-ld-53" value="&lt;div&gt;&lt;b&gt;WAS: Tomcat 9 + PetClinic (JDK 17)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;WAR 1개, 헬스체크 &lt;code&gt;/petclinic/&lt;/code&gt;. 스레드 200·커넥션 풀 100 기본값. ASG 없음 — AZ당 1대&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1512" y="382" width="400" height="90" as="geometry"/></mxCell><mxCell id="p1-lb-54" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1460" y="480" width="40" height="38" as="geometry"/></mxCell><mxCell id="p1-ld-55" value="&lt;div&gt;&lt;b&gt;DB: RDS MySQL 8.0&lt;/b&gt;&lt;/div&gt;&lt;div&gt;WAS SG에서만 3306 허용. 저장 암호화. Multi-AZ standby(자동 failover). DB 접속정보는 &lt;code&gt;-Djdbc.*&lt;/code&gt;로 주입&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1512" y="478" width="400" height="90" as="geometry"/></mxCell><mxCell id="p1-lb-56" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1460" y="576" width="40" height="38" as="geometry"/></mxCell><mxCell id="p1-ld-57" value="&lt;div&gt;&lt;b&gt;'대응 전' 기준값 기록&lt;/b&gt;&lt;/div&gt;&lt;div&gt;헬스체크 30s / maxThreads 200 / 풀 100 / max_connections 기본 / 정적 자원 WAS 서빙 → 5일차 폭주 실험의 출발점&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1512" y="574" width="400" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pm" name="2. 최소 설계 — 티어별 과부하 방어"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pm-title-1" value="" style="group;fontFamily=Helvetica;" connectable="0" vertex="1" parent="1"><mxGeometry x="50" y="30" width="2220" height="83" as="geometry"/></mxCell><mxCell id="pm-v-2" value="PetClinic 3-Tier — 티어별 트래픽 과부하 방어 (최소 설계)" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="pm-title-1"><mxGeometry x="0" y="0" width="1100" height="42" as="geometry"/></mxCell><mxCell id="pm-v-3" va