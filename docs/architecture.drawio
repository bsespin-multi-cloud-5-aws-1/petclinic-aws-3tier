;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="860" y="506" width="28" height="28" as="geometry"/></mxCell><mxCell id="p2-badge-66" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="860" y="766" width="28" height="28" as="geometry"/></mxCell><mxCell id="p2-badge-67" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="992" y="912" width="28" height="28" as="geometry"/></mxCell><mxCell id="p2-badge-68" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="860" y="956" width="28" height="28" as="geometry"/></mxCell><mxCell id="p2-badge-69" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1540" y="526" width="28" height="28" as="geometry"/></mxCell><mxCell id="p2-legend-70" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1760" y="140" width="500" height="636" as="geometry"/></mxCell><mxCell id="p2-lt-71" value="계층별 과부하 대응 — 엣지에서 자르고, 중간에서 흡수하고, DB를 보호" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1780" y="154" width="460" height="24" as="geometry"/></mxCell><mxCell id="p2-lb-72" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="192" width="40" height="38" as="geometry"/></mxCell><mxCell id="p2-ld-73" value="&lt;div&gt;&lt;b&gt;진입: CloudFront + WAF&lt;/b&gt;&lt;/div&gt;&lt;div&gt;정적 자원(&lt;code&gt;/petclinic/resources/*&lt;/code&gt;)을 엣지 캐시 → ALB로 가는 요청 수 자체를 감소. WAF rate-based rule로 폭주 IP·경로 제한(응급 접수 경로는 제외)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="190" width="400" height="90" as="geometry"/></mxCell><mxCell id="p2-lb-74" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="288" width="40" height="38" as="geometry"/></mxCell><mxCell id="p2-ld-75" value="&lt;div&gt;&lt;b&gt;WEB: Apache 튜닝 + WEB ASG&lt;/b&gt;&lt;/div&gt;&lt;div&gt;MPM event &lt;code&gt;MaxRequestWorkers&lt;/code&gt;·keepalive, 정적 파일 직접 서빙(&lt;code&gt;mod_expires&lt;/code&gt;), 필요 시 &lt;code&gt;mod_qos&lt;/code&gt;. ASG AZ당 2대&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="286" width="400" height="90" as="geometry"/></mxCell><mxCell id="p2-lb-76" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="384" width="40" height="38" as="geometry"/></mxCell><mxCell id="p2-ld-77" value="&lt;div&gt;&lt;b&gt;WAS: Tomcat 튜닝 + WAS ASG&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;maxThreads&lt;/code&gt;·&lt;code&gt;acceptCount&lt;/code&gt; 산정, AZ당 2대(N+1: 한 AZ 손실 시 피크 100%), 이벤트 15분 전 Scheduled Scaling + Target Tracking, 헬스체크 5s/2&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="382" width="400" height="90" as="geometry"/></mxCell><mxCell id="p2-lb-78" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="480" width="40" height="38" as="geometry"/></mxCell><mxCell id="p2-ld-79" value="&lt;div&gt;&lt;b&gt;앱↔DB 연결: 풀 + RDS Proxy&lt;/b&gt;&lt;/div&gt;&lt;div&gt;tomcat-jdbc 풀 크기 = f(WAS 수, max_connections), &lt;code&gt;validationQuery&lt;/code&gt;·&lt;code&gt;testOnBorrow&lt;/code&gt;. RDS Proxy가 연결을 다중화하고 failover 중 연결 유지. 자격증명은 Secrets Manager&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="478" width="400" height="90" as="geometry"/></mxCell><mxCell id="p2-lb-80" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="576" width="40" height="38" as="geometry"/></mxCell><mxCell id="p2-ld-81" value="&lt;div&gt;&lt;b&gt;DB: RDS 보호&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Multi-AZ standby, &lt;code&gt;max_connections&lt;/code&gt;·파라미터 그룹, Performance Insights로 top SQL 확인. Read Replica는 앱 수정 필요 → 로드맵&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="574" width="400" height="90" as="geometry"/></mxCell><mxCell id="p2-lb-82" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="672" width="40" height="38" as="geometry"/></mxCell><mxCell id="p2-ld-83" value="&lt;div&gt;&lt;b&gt;관측: 전/후 측정&lt;/b&gt;&lt;/div&gt;&lt;div&gt;CloudWatch 대시보드(RequestCount·p95·HealthyHost·5XX·DB 연결·스레드) + 알람→SNS. JMeter로 '기준선 → 계층 조치 → 재측정' 반복해 표로 정리&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="670" width="400" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>