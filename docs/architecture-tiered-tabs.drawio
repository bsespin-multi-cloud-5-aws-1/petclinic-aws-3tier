        <mxCell id="legend-title" value="운영 · 관측 공통 — 흐름과 설정" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="legend-container">
