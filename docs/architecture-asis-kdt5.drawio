Point x="685" y="700" /><mxPoint x="400" y="700" /></Array></mxGeometry></mxCell><mxCell id="e5-l" value="tg-internal-alb :8080 (미연결)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;fontSize=10;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e5"><mxGeometry relative="1" x="0.2" y="-10" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;strokeWidth=1.5;fontFamily=Helvetica;dashed=1;strokeColor=#D32F2F;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-was-a" target="grp-rds-a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6-l" value="DB 없음" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;fontSize=10;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e6"><mxGeometry relative="1" x="0" y="-10" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=block;startFill=1;endFill=1;strokeColor=#545B64;rounded=0;dashed=1;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-bastion" target="grp-web-a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="465" y="435" /><mxPoint x="400" y="435" /></Array></mxGeometry></mxCell><mxCell id="e7-l" value="SSH 22 (test-key)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;fontSize=10;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e7"><mxGeometry relative="1" x="0.6" y="12" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="n1" value="&lt;b&gt;WEB → WAS 연동 현황&lt;/b&gt;&lt;br&gt;사용자 → Public ALB → Apache까지는 200(index.html). &lt;b&gt;/petclinic/ 는 Apache가 404&lt;/b&gt; — ProxyPass · ProxyPreserveHost 없음, 내부 ALB 없음. WAS Tomcat 상태는 확인 불가(SSM 미등록 · 키 없음)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D32F2F;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="300" width="470" height="120" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;보안 설정 차이&lt;/b&gt;&lt;br&gt;• was-instance-sg 8080·443 ← 0.0.0.0/0, web-instance-sg 80 ← 0.0.0.0/0 (앞 단계 SG만 허용해야 함)&lt;br&gt;• EC2 3대 모두 IAM 프로파일 없음 → SSM·CloudWatch·Secrets 불가 (mc-ec2-role은 만들어져 있음)&lt;br&gt;• Bastion + 22번 + test-key: 설계는 SSM으로 대체&lt;br&gt;• DB 서브넷 라우팅이 NAT로 나감 (설계: local만)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D32F2F;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="440" width="470" height="170" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;없는 것&lt;/b&gt;&lt;br&gt;Internal ALB · WEB-C · WAS-C · RDS(Multi-AZ) · AMI v1 · Route 53 호스팅 존 · health.html · test.jsp&lt;br&gt;&lt;b&gt;다른 것&lt;/b&gt;&lt;br&gt;WAS/WEB이 AL2023 · t3.micro (Blue 컨셉은 AL2 · 구버전, 빌드엔 t3.medium 필요) · 헬스체크 경로 / (설계: WEB /health.html · WAS /petclinic/) · EIP 4개(2개 용도 불명)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#0B5394;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="630" width="470" height="200" as="geometry" /></mxCell><mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FB;strokeColor=#0B5394;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="850" width="470" height="138" as="geometry" /></mxCell><mxCell id="legend-t" value="범례" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#0B5394;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1474" y="860" width="442" height="26" as="geometry" /></mxCell><mxCell id="legend-b" value="&lt;div style='margin:3px 0'&gt;■ 실선 = 현재 동작하는 경로&lt;/div&gt;&lt;div style='margin:3px 0'&gt;&lt;span style='color:#D32F2F'&gt;■ 붉은 점선 = 끊겨 있거나 없는 구성&lt;/span&gt;&lt;/div&gt;&lt;div style='margin:3px 0'&gt;■ 점선 양방향 = 운영자 접속(SSH)&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1474" y="892" width="442" height="88" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>