0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7B7B7B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fontFamily=Helvetica;" vertex="1" parent="grp-secrets"><mxGeometry x="105" y="26" width="44" height="44" as="geometry" /></mxCell><mxCell id="grp-grafana" value="Managed Grafana (선택)" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#9E9E9E;fontFamily=Helvetica;container=1;collapsible=0;shadow=0;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2200" y="875" width="270" height="110" as="geometry" /></mxCell><mxCell id="grafana" value="enable_grafana=false&lt;br&gt;mc-ops · CLOUDWATCH" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#9E9E9E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.managed_service_for_grafana;fontFamily=Helvetica;" vertex="1" parent="grp-grafana"><mxGeometry x="113" y="26" width="44" height="44" as="geometry" /></mxCell><mxCell id="ops-why" value="&lt;b&gt;왜&lt;/b&gt; 로그 5종(WAF·WEB·WAS·ALB·SSM) 중 코드가 끝까지 만드는 건 그룹·버킷·정책·설정까지. 인스턴스 안(Agent 설치)·ALB 속성(액세스 로그)은 기존 리소스라 콘솔(ⓜ2·ⓜ4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FB;strokeColor=#0B5394;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2485" y="875" width="255" height="110" as="geometry" /></mxCell><mxCell id="manual" value="&lt;b&gt;수동 후속 ⓜ1~7 (output manual_followups · infra/terraform-kdt5/MANUAL-FOLLOWUPS.md)&lt;/b&gt;&lt;br&gt;ⓜ1 가비아 네임서버 → route53_name_servers 4개 (apply 중 ACM 검증이 이걸 기다림)&lt;br&gt;ⓜ2 test-Public-ALB · alb-internal-test 속성 → 액세스 로그 → s3://mc-logs-723165663216/alb/public · /alb/internal&lt;br&gt;ⓜ3 시작 템플릿 web 새 버전 + WAS-test-a: IAM 인스턴스 프로파일 mc-ec2-role 부착 → ASG 인스턴스 새로 고침&lt;br&gt;ⓜ4 WEB(AMI 빌더)·WAS: amazon-cloudwatch-agent 설치 → fetch-config -c ssm:/petclinic/cwagent/web|was → AMI web-appache v2&lt;br&gt;ⓜ5 WAS: was_jdbc_url 로 WAR 재빌드(mvnw -P MySQL -Djdbc.*) → test.jsp 에서 Ssl_cipher 확인 → petclinic-db-sg 의 3306 ← was-instance-sg 삭제&lt;br&gt;ⓜ6 CloudFront 로 접속 확인 후: Public ALB 80 리스너 삭제 · alb-public-sg 80/443 0.0.0.0/0 · 22 규칙 삭제 (CloudFront 프리픽스 443 만)&lt;br&gt;ⓜ7 database-1 재부팅(점검 시간) → mc-mysql80 적용 (apply_immediately=false 라 안 하면 월 13:01 UTC 유지관리 창)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="580" y="1170" width="2180" height="200" as="geometry" /></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;strokeWidth=1.5;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="grp-r53"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0-l" value="DNS" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;fontSize=10;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e0"><mxGeometry relative="1" x="0" y="-10" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64