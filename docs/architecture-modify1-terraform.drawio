html=1;endArrow=block;elbow=vertical;startArrow=block;startFill=1;endFill=1;strokeColor=#545B64;rounded=0;dashed=1;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-ssm" target="grp-was-a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="619" /><mxPoint x="200" y="660" /></Array></mxGeometry></mxCell><mxCell id="e8-l" value="세션" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;fontSize=10;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e8"><mxGeometry relative="1" x="0" y="-10" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=block;startFill=1;endFill=1;strokeColor=#545B64;rounded=0;dashed=1;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-secrets" target="grp-was-a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="899" /><mxPoint x="200" y="740" /></Array></mxGeometry></mxCell><mxCell id="e9-l" value="부팅 시 조회 → 빌드 주입" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;fontSize=10;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e9"><mxGeometry relative="1" x="0.4" y="-10" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;strokeColor=#DD344C;dashed=1;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-iam" target="grp-was-a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="759" /><mxPoint x="185" y="720" /></Array></mxGeometry></mxCell><mxCell id="e10-l" value="프로파일 부착" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;fontSize=10;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e10"><mxGeometry relative="1" x="0.2" y="-10" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="n1" value="&lt;b&gt;파일 → 리소스 (infra/terraform-phase1)&lt;/b&gt;&lt;br&gt;• &lt;code&gt;network.tf&lt;/code&gt; VPC · IGW · 서브넷 8 · EIP/NAT ×2 · 라우팅 4&lt;br&gt;• &lt;code&gt;security.tf&lt;/code&gt; SG 체인 (22번 규칙 없음)&lt;br&gt;• &lt;code&gt;iam.tf&lt;/code&gt; mc-ec2-role · 인스턴스 프로파일&lt;br&gt;• &lt;code&gt;alb.tf&lt;/code&gt; Public/Internal ALB · TG · 리스너 · 대상 등록&lt;br&gt;• &lt;code&gt;compute.tf&lt;/code&gt; web ×2 · was ×2 (templatefile user_data) · bastion(선택)&lt;br&gt;• &lt;code&gt;rds.tf&lt;/code&gt; 서브넷 그룹 · 파라미터 그룹 · RDS Multi-AZ&lt;br&gt;• &lt;code&gt;user_data/web.sh · was.sh&lt;/code&gt; Apache 설정 / Tomcat·앱 빌드·DB 검증" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FB;strokeColor=#0B5394;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="300" width="560" height="190" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;SG 체인 (소스 = 앞 단계 SG)&lt;/b&gt;&lt;br&gt;mc-sg-alb-public 80 ← var.public_alb_ingress_cidrs (0.0.0.0/0)&lt;br&gt;mc-sg-web 80 ← sg-alb-public&lt;br&gt;mc-sg-alb-internal 8080 ← sg-web&lt;br&gt;mc-sg-was 8080 ← sg-alb-internal&lt;br&gt;mc-sg-rds 3306 ← sg-was&lt;br&gt;Bastion 켜면 sg-bastion 22 ← var.bastion_ssh_cidrs, web/was 22 ← sg-bastion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FB;strokeColor=#0B5394;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="505" width="560" height="150" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;이번 커밋(933e79b)에서 바뀐 것 — 붉은 화살표&lt;/b&gt;&lt;br&gt;① &lt;b&gt;WEB&lt;/b&gt;: Apache 자체 index.html 생성 삭제 + &lt;code&gt;rm -f&lt;/code&gt;. &lt;code&gt;RewriteRule ^/$ /petclinic/ [R=302]&lt;/code&gt; 로 첫 화면을 WAS(Spring welcome.jsp)가 담당. &lt;code&gt;ProxyPass /health.html !&lt;/code&gt; 만 Apache 직접 응답(헬스체크)&lt;br&gt;④ &lt;b&gt;WAS→RDS&lt;/b&gt;: Secrets Manager 계정 조회 → &lt;code&gt;mvnw -P MySQL -Djdbc.url/username/password&lt;/code&gt; 빌드 주입(datasource-config.xml 이 Maven 필터링되므로 런타임 주입 불가) → RDS 3306 도달 대기 → mysql 로그인·DB 확인 → Tomcat 기동 → 앱이 schema.sql·data.sql 실행 → vets/owners/pets 건수 검증 · 자격증명 unset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D32F2F;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="670" width="560" height="210" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;변수 기본값 (variables.tf)&lt;/b&gt;&lt;br&gt;web t3.small · was t3.medium · tomcat 9.0.53 · app_repo_branch=main · db 8.4.11 db.t3.small multi_az=true · create_bastion=false&lt;br&gt;&lt;b&gt;Phase 2&lt;/b&gt;: app_repo_branch=test · tomcat_version=9.0.121 → WAS 재생성(user_data_replace_on_change)&lt;br&gt;&lt;b&gt;outputs&lt;/b&gt;: public_alb_dns · internal_alb_dns · rds_endpoint · rds_master_secret_arn · ssm_session_hint · db_check_hint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FB;strokeColor=#0B5394;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="895" width="560" height="130" as="geometry" /></mxCell><mxCell id="legend" value="■ 실선 = 요청 흐름 · &lt;span style='color:#D32F2F'&gt;■ 붉은 실선 = 이번 커밋 변경 구간&lt;/span&gt; · ■ 점선 양방향 = 복제·운영 접속·비밀 조회 · ■ 회색 점선 박스 = 변수로 끄고 켜는 선택 리소스" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="140" y="1080" width="1300" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>