r=#ffffff;fontSize=10;fontFamily=Helvetica;" connectable="0" vertex="1" parent="ph1-e-43"><mxGeometry relative="1" x="0.55" y="12" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="ph1-badge-44" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="320" y="184" width="28" height="28" as="geometry"/></mxCell><mxCell id="ph1-badge-45" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="890" y="360" width="28" height="28" as="geometry"/></mxCell><mxCell id="ph1-badge-46" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="860" y="506" width="28" height="28" as="geometry"/></mxCell><mxCell id="ph1-badge-47" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="860" y="766" width="28" height="28" as="geometry"/></mxCell><mxCell id="ph1-badge-48" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="860" y="956" width="28" height="28" as="geometry"/></mxCell><mxCell id="ph1-note-49" value="&lt;b&gt;Phase 1 원칙&lt;/b&gt;&lt;br&gt;· 앱 코드 무수정, 제공본 &lt;code&gt;main&lt;/code&gt; 그대로&lt;br&gt;· DB 접속정보는 빌드 시점 &lt;code&gt;mvnw -Djdbc.*&lt;/code&gt; 주입 (Maven 필터링이라 런타임 주입 불가 · pom에 비밀번호 없음)&lt;br&gt;· WEB/WAS 퍼블릭 IP 없음, 22번 포트 없음 (관리 접속은 Phase 2 SSM)&lt;br&gt;· 취약 상태(Spring4Shell)라 Public ALB SG는 팀 IP만&lt;br&gt;· AMI v1 = Phase 2 롤백 지점" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="180" height="210" as="geometry"/></mxCell><mxCell id="ph1-legend-50" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=#EDF3FF;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1760" y="140" width="520" height="520" as="geometry"/></mxCell><mxCell id="ph1-lt-51" value="요청 흐름 — 기준선" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1780" y="154" width="480" height="24" as="geometry"/></mxCell><mxCell id="ph1-lb-52" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="192" width="40" height="38" as="geometry"/></mxCell><mxCell id="ph1-ld-53" value="&lt;div&gt;&lt;b&gt;Route 53 → Public ALB&lt;/b&gt;&lt;/div&gt;&lt;div&gt;구매한 도메인의 A 레코드(별칭)가 인터넷 경계 ALB를 가리킴. IGW를 지나 퍼블릭 서브넷의 ALB로 진입&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="190" width="420" height="88" as="geometry"/></mxCell><mxCell id="ph1-lb-54" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="284" width="40" height="38" as="geometry"/></mxCell><mxCell id="ph1-ld-55" value="&lt;div&gt;&lt;b&gt;Public ALB → WEB&lt;/b&gt;&lt;/div&gt;&lt;div&gt;대상 그룹 &lt;code&gt;tg-web&lt;/code&gt;(HTTP 80, 헬스체크 &lt;code&gt;/&lt;/code&gt;). AZ-A/C의 Apache 2.4로 분산. SG: ALB에서만 80 허용&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="282" width="420" height="88" as="geometry"/></mxCell><mxCell id="ph1-lb-56" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="376" width="40" height="38" as="geometry"/></mxCell><mxCell id="ph1-ld-57" value="&lt;div&gt;&lt;b&gt;WEB(Apache)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;index.html&lt;/code&gt; 정적 서비스. &lt;code&gt;ProxyPass /petclinic/&lt;/code&gt; → Internal ALB DNS. WAS 주소를 모름&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="374" width="420" height="88" as="geometry"/></mxCell><mxCell id="ph1-lb-58" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="468" width="40" height="38" as="geometry"/></mxCell><mxCell id="ph1-ld-59" value="&lt;div&gt;&lt;b&gt;Internal ALB → WAS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;대상 그룹 &lt;code&gt;tg-was&lt;/code&gt;(HTTP 8080, 헬스체크 &lt;code&gt;/petclinic/&lt;/code&gt;). Tomcat 9.0.53 + PetClinic WAR. SG: Internal ALB에서만 8080&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="466" width="420" height="88" as="geometry"/></mxCell><mxCell id="ph1-lb-60" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="560" width="40" height="38" as="geometry"/></mxCell><mxCell id="ph1-ld-61" value="&lt;div&gt;&lt;b&gt;WAS → RDS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;JDBC 3306, SG: WAS에서만. RDS Multi-AZ 동기 standby, 저장 암호화. 테이블은 앱이 첫 기동 시 자동 생성&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="558" width="420" height="88" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>