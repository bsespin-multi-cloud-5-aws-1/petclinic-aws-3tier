lLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_storage_service;fontFamily=Helvetica;" vertex="1" parent="grp-s3-maint"><mxGeometry x="78" y="26" width="44" height="44" as="geometry" /></mxCell><mxCell id="grp-kms" value="KMS alias/mc-cmk" style="fillColor=#FFEBEE;strokeColor=#DD344C;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#DD344C;fontFamily=Helvetica;container=1;collapsible=0;shadow=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="512" width="210" height="110" as="geometry" /></mxCell><mxCell id="kms" value="S3(점검·정적·CloudTrail) · SNS · Logs · Backup · &lt;b&gt;app-db 비밀&lt;/b&gt;&lt;br&gt;RDS 스토리지·admin 비밀은 AWS 관리형 키" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;fontFamily=Helvetica;" vertex="1" parent="grp-kms"><mxGeometry x="83" y="26" width="44" height="44" as="geometry" /></mxCell><mxCell id="edge-how" value="&lt;b&gt;정적 · 동적 분리 (9/17)&lt;/b&gt;&lt;br&gt;• 정적 &lt;code&gt;/static/*&lt;/code&gt; &lt;code&gt;/images/*&lt;/code&gt;(랜딩 css·이미지·hero.mp4): CloudFront → &lt;b&gt;S3 mc-static(OAC)&lt;/b&gt; · CachingOptimized 1일 → Hit 면 엣지, Miss 면 S3 — &lt;b&gt;Apache 를 안 거침&lt;/b&gt;&lt;br&gt;• &lt;code&gt;/petclinic/resources/*&lt;/code&gt;(WAR 안): 오리진 그룹(ALB) 캐시 · AllViewer 로 Host 전달&lt;br&gt;• 동적 &lt;code&gt;*&lt;/code&gt;: CachingDisabled + AllViewer → 매번 ALB → Apache → Internal ALB → Tomcat&lt;br&gt;• WAF 는 팀 결정으로 유지 — Web ACL 은 캐시 조회보다 먼저 평가, 차단은 캐시·오리진 미도달. Phase 3 전 loadgen IP set 에 JMeter IP" style="