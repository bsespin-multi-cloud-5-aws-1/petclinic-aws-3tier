olor=none;" vertex="1" parent="1"><mxGeometry x="670" y="808" width="28" height="28" as="geometry"/></mxCell><mxCell id="ph2-badge-65" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1540" y="766" width="28" height="28" as="geometry"/></mxCell><mxCell id="ph2-badge-66" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="320" y="366" width="28" height="28" as="geometry"/></mxCell><mxCell id="ph2-note-67" value="&lt;b&gt;전환 절차 (5일차)&lt;/b&gt;&lt;br&gt;진단(trivy, Spring4Shell) → 스테이징 WAS로 Green 검증 → AMI v2 → &lt;code&gt;tg-was-green&lt;/code&gt; 생성 → Internal ALB 가중치 10→50→100% → 점검표·JMeter 비교 → &lt;b&gt;롤백 리허설&lt;/b&gt;(가중치 되돌리기) → Blue 종료&lt;br&gt;&lt;br&gt;&lt;b&gt;운영 (6일차)&lt;/b&gt;&lt;br&gt;Secrets Manager · CloudWatch 알람→SNS · PITR 복원 드릴 · OS 롤링 패치 · 런북 6장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="180" height="300" as="geometry"/></mxCell><mxCell id="ph2-legend-68" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=#EDF3FF;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1760" y="140" width="520" height="612" as="geometry"/></mxCell><mxCell id="ph2-lt-69" value="이관·운영 흐름" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1780" y="154" width="480" height="24" as="geometry"/></mxCell><mxCell id="ph2-lb-70" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="192" width="40" height="38" as="geometry"/></mxCell><mxCell id="ph2-ld-71" value="&lt;div&gt;&lt;b&gt;진단 → Green 이미지&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Blue(AL2·Spring 5.3.9)에서 CVE-2022-22965 등 확인 → 업데이트 브랜치로 스테이징 WAS 검증 → AMI v2 생성. Blue의 AMI v1은 롤백 지점&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="190" width="420" height="88" as="geometry"/></mxCell><mxCell id="ph2-lb-72" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="284" width="40" height="38" as="geometry"/></mxCell><mxCell id="ph2-ld-73" value="&lt;div&gt;&lt;b&gt;Green 대상 그룹&lt;/b&gt;&lt;/div&gt;&lt;div&gt;AMI v2로 AZ-A/C에 Green WAS 시작 → &lt;code&gt;tg-was-green&lt;/code&gt;(8080, &lt;code&gt;/petclinic/&lt;/code&gt;) 등록 → healthy&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="282" width="420" height="88" as="geometry"/></mxCell><mxCell id="ph2-lb-74" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="376" width="40" height="38" as="geometry"/></mxCell><mxCell id="ph2-ld-75" value="&lt;div&gt;&lt;b&gt;가중치 전환 (Canary → Blue/Green)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Internal ALB 리스너에서 Blue:Green = 90:10 → 50:50 → 0:100. 단계마다 5XX·p95 관찰. 점검 시간 허용이면 한 번에 0:100도 가능&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="374" width="420" height="88" as="geometry"/></mxCell><mxCell id="ph2-lb-76" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="468" width="40" height="38" as="geometry"/></mxCell><mxCell id="ph2-ld-77" value="&lt;div&gt;&lt;b&gt;검증 · 롤백 리허설 · Blue 폐기&lt;/b&gt;&lt;/div&gt;&lt;div&gt;점검표 5개 + JMeter 전/후 비교 → 가중치를 100:0으로 되돌려 롤백 시간 측정 → 다시 Green 100 → Blue 종료, Public ALB 전체 공개&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="466" width="420" height="88" as="geometry"/></mxCell><mxCell id="ph2-lb-78" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="560" width="40" height="38" as="geometry"/></mxCell><mxCell id="ph2-ld-79" value="&lt;div&gt;&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;/div&gt;&lt;div&gt;DB 자격증명을 setenv에서 제거하고 부팅 시 조회(IAM 역할 권한). 스냅샷·백업 7일 + PITR 복원 드릴 1회&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="558" width="420" height="88" as="geometry"/></mxCell><mxCell id="ph2-lb-80" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="652" width="40" height="38" as="geometry"/></mxCell><mxCell id="ph2-ld-81" value="&lt;div&gt;&lt;b&gt;SSM · 알람 · 패치&lt;/b&gt;&lt;/div&gt;&lt;div&gt;운영자는 Session Manager로만 접속(22번·키페어 없음). CloudWatch 알람 3개 → SNS. WAS 1대씩 TG 제외 → OS 패치 → 복귀(무중단)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1832" y="650" width="420" height="88" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>