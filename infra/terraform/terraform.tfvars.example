# 복사해서 terraform.tfvars 로 저장 (tfvars는 커밋하지 않음)
owner            = "박준석"
domain_name      = "hospital.example.com"
hosted_zone_name = "example.com"

web_ami_id = "ami-xxxxxxxxxxxxxxxxx" # mc-web-v2 (AL2023 · Apache · CloudWatch Agent)
was_ami_id = "ami-xxxxxxxxxxxxxxxxx" # mc-was-v2 (AL2023 · Corretto 17 · Tomcat 9.0.121)

origin_verify_secret = "change-me-random-32-chars"

# 실험 중에만: JMeter 공인 IP
loadgen_cidrs = ["203.0.113.10/32"]

alert_emails            = ["team@example.com"]
slack_team_id           = "" # AWS Chatbot 콘솔에서 Slack 워크스페이스 연결 후 ID 입력
slack_alerts_channel_id = ""
enable_grafana          = false
